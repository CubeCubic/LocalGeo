# Set these values in Render's Environment settings. Never commit a real .env file.
ADMIN_PASSWORD=use-a-long-unique-password
ADMIN_TOKEN_SECRET=use-a-random-secret-of-at-least-32-characters
RESEND_API_KEY=re_...
NOTIFICATION_EMAIL=your-resend-account-email@example.com
EMAIL_FROM=LocalGeo <onboarding@resend.dev>
# Set to true only after verifying your own domain in Resend.
SEND_CUSTOMER_CONFIRMATIONS=false
# After the public Turnstile widget has been deployed, add its matching secret here.
TURNSTILE_SECRET_KEY=0x0000000000000000000000000000000AA
